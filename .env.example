# Local development environment variables for pg-compass

# Directory where app data (connections, settings, etc) will be stored
# Leave empty to use default app data directory
PG_COMPASS_STORE_DIR=

# ==================== Testing Configuration ====================
# Choose ONE of these two approaches for testing:

# APPROACH 1: Admin Connection (Recommended for full test isolation)
# Requires a postgres user with admin/superuser privileges
# Tests will create isolated test databases dynamically
# Uncomment and use if your local postgres has a superuser account:
PG_COMPASS_TEST_ADMIN_DATABASE_URL=postgresql://postgres:root@localhost:5432/postgres

# APPROACH 2: Fixed Test Database
# Use this if you don't have admin access or prefer a fixed database
# You need to manually create this database beforehand
# Uncomment and use instead of APPROACH 1:
# PG_COMPASS_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pg_compass_test

# ==================== Test Dialog Paths ====================
# Directories for testing file save/load dialogs
# Leave empty to use system temp directory
PG_COMPASS_TEST_SAVE_DIALOG_DIR=
PG_COMPASS_TEST_SAVE_DIALOG_PATH=
