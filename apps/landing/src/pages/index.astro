<script is:inline define:vars={{ githubLatestReleaseApiUrl, githubLatestReleaseUrl }}>
  const platformDownloads = [
    {
      key: 'windows',
      label: 'Windows',
      primaryText: 'Download for Windows',
      matches: [/setup.*\.exe$/i, /\.msi$/i, /windows|win32|win/i],
      excludes: [/\.nupkg$/i],
    },
    {
      key: 'macos',
      label: 'macOS',
      primaryText: 'Download for macOS',
      matches: [/\.dmg$/i, /macos|darwin|osx|mac/i],
      excludes: [],
    },
    {
      key: 'linux',
      label: 'Linux',
      primaryText: 'Download for Linux',
      matches: [/\.appimage$/i, /\.deb$/i, /\.rpm$/i, /linux/i],
      excludes: [],
    },
  ];

  const platformPriority = {
    windows: [/setup.*\.exe$/i, /\.exe$/i, /\.msi$/i],
    macos: [/\.dmg$/i, /arm64.*\.zip$/i, /\.zip$/i],
    linux: [/\.appimage$/i, /\.deb$/i, /\.rpm$/i],
  };

  function formatAssetSize(bytes) {
    if (!Number.isFinite(bytes) || bytes <= 0) {
      return '';
    }

    const units = ['B', 'KB', 'MB', 'GB'];
    let size = bytes;
    let unitIndex = 0;

    while (size >= 1024 && unitIndex < units.length - 1) {
      size /= 1024;
      unitIndex += 1;
    }

    return `${size.toFixed(size >= 10 || unitIndex === 0 ? 0 : 1)} ${units[unitIndex]}`;
  }

  function detectVisitorPlatform() {
    const userAgent = window.navigator.userAgent.toLowerCase();
    const userAgentData = window.navigator.userAgentData;
    const platform = (userAgentData?.platform || '').toLowerCase();
    const source = `${platform} ${userAgent}`;

    if (source.includes('win')) {
      return 'windows';
    }

    if (source.includes('mac')) {
      return 'macos';
    }

    if (source.includes('linux') || source.includes('x11')) {
      return 'linux';
    }

    return 'windows';
  }

  function assetMatchesPlatform(asset, platform) {
    const name = asset.name || '';
    const config = platformDownloads.find((item) => item.key === platform);

    if (!config) {
      return false;
    }

    const excluded = config.excludes.some((pattern) => pattern.test(name));
    const matched = config.matches.some((pattern) => pattern.test(name));

    return matched && !excluded;
  }

  function chooseBestAsset(assets, platform) {
    const candidates = assets.filter((asset) => assetMatchesPlatform(asset, platform));
    const priority = platformPriority[platform] || [];

    for (const pattern of priority) {
      const match = candidates.find((asset) => pattern.test(asset.name || ''));
      if (match) {
        return match;
      }
    }

    return candidates[0] || null;
  }

  function setPrimaryDownload(platformConfig, asset) {
    const primaryLinks = [
      document.getElementById('primary-download'),
      document.getElementById('download-section-primary'),
    ];
    const primaryLabels = [
      document.getElementById('primary-download-label'),
      document.getElementById('download-section-primary-label'),
    ];

    const href = asset?.browser_download_url || githubLatestReleaseUrl;
    const label = asset ? platformConfig.primaryText : 'View latest release';

    primaryLinks.forEach((link) => {
      if (link instanceof HTMLAnchorElement) {
        link.href = href;
      }
    });

    primaryLabels.forEach((labelElement) => {
      if (labelElement) {
        labelElement.textContent = label;
      }
    });
  }

  function updatePlatformRows(assets) {
    platformDownloads.forEach((platformConfig) => {
      const row = document.querySelector(`[data-platform-download="${platformConfig.key}"]`);
      const meta = row?.querySelector('.download-meta');
      const action = row?.querySelector('.download-action');
      const asset = chooseBestAsset(assets, platformConfig.key);

      if (!(row instanceof HTMLAnchorElement) || !meta || !action) {
        return;
      }

      if (!asset) {
        row.href = githubLatestReleaseUrl;
        row.classList.add('is-unavailable');
        meta.textContent = 'No dedicated asset in the latest release';
        action.textContent = 'View release';
        return;
      }

      const size = formatAssetSize(asset.size);
      row.href = asset.browser_download_url;
      meta.textContent = size ? `${asset.name} - ${size}` : asset.name;
      action.textContent = 'Download';
    });
  }

  async function hydrateDownloads() {
    const visitorPlatform = detectVisitorPlatform();
    const visitorPlatformConfig =
      platformDownloads.find((item) => item.key === visitorPlatform) || platformDownloads[0];

    try {
      const response = await fetch(githubLatestReleaseApiUrl, {
        headers: { Accept: 'application/vnd.github+json' },
      });

      if (!response.ok) {
        throw new Error(`GitHub release lookup failed: ${response.status}`);
      }

      const release = await response.json();
      const assets = Array.isArray(release.assets) ? release.assets : [];
      const primaryAsset = chooseBestAsset(assets, visitorPlatformConfig.key);

      setPrimaryDownload(visitorPlatformConfig, primaryAsset);
      updatePlatformRows(assets);
    } catch {
      setPrimaryDownload(visitorPlatformConfig, null);

      document.querySelectorAll('.download-meta').forEach((meta) => {
        meta.textContent = 'Open GitHub to see the latest assets';
      });
    }
  }

  hydrateDownloads();
</script>

