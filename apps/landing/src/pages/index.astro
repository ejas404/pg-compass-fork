<script is:inline>

  const githubLatestReleaseUrl = 'https://github.com/waterrmalann/pg-compass/releases/latest';
  const githubLatestReleaseApiUrl = 'https://api.github.com/repos/waterrmalann/pg-compass/releases/latest';
  const githubRepoUrl = 'https://github.com/waterrmalann/pg-compass';
  const githubRepoApiUrl = 'https://api.github.com/repos/waterrmalann/pg-compass';

  const platformDownloads = [
    {
      key: 'windows',
      primaryText: 'Download for Windows',
      matches: [/setup.*\.exe$/i, /\.msi$/i, /windows|win32|win64/i],
      excludes: [/\.nupkg$/i],
    },
    {
      key: 'linux',
      primaryText: 'Download for Linux',
      matches: [/\.appimage$/i, /\.deb$/i, /\.rpm$/i, /linux/i],
      excludes: [],
    },
  ];

  const platformPriority = {
    windows: [/setup.*\.exe$/i, /\.exe$/i, /\.msi$/i],
    linux: [/\.appimage$/i, /\.deb$/i, /\.rpm$/i],
  };

  function detectVisitorPlatform() {
    const userAgent = window.navigator.userAgent.toLowerCase();
    const userAgentData = window.navigator.userAgentData;
    const platform = (userAgentData?.platform || '').toLowerCase();
    const source = `${platform} ${userAgent}`;

    if (source.includes('win')) return 'windows';
    if (source.includes('linux') || source.includes('x11')) return 'linux';
    return 'windows';
  }

  function assetMatchesPlatform(asset, platform) {
    const name = asset.name || '';
    const config = platformDownloads.find((item) => item.key === platform);
    if (!config) return false;
    return config.matches.some((pattern) => pattern.test(name)) && !config.excludes.some((pattern) => pattern.test(name));
  }

  function chooseBestAsset(assets, platform) {
    const candidates = assets.filter((asset) => assetMatchesPlatform(asset, platform));
    const priority = platformPriority[platform] || [];

    for (const pattern of priority) {
      const match = candidates.find((asset) => pattern.test(asset.name || ''));
      if (match) return match;
    }

    return candidates[0] || null;
  }

  function setPrimaryDownload(platformConfig, asset) {
    const href = asset?.browser_download_url || githubLatestReleaseUrl;
    const label = asset ? platformConfig.primaryText : 'View latest release';

    document.querySelectorAll('#primary-download, #cta-download').forEach((link) => {
      if (link instanceof HTMLAnchorElement) link.href = href;
    });

    document.querySelectorAll('[data-download-label]').forEach((labelElement) => {
      labelElement.textContent = label;
    });
  }

  function formatAssetSize(bytes) {
    if (!Number.isFinite(bytes) || bytes <= 0) return 'latest asset';
    const megabytes = bytes / (1024 * 1024);
    return `${megabytes.toFixed(megabytes >= 10 ? 0 : 1)} MB`;
  }

  function updatePlatformLinks(assets) {
    platformDownloads.forEach((platformConfig) => {
      const link = document.querySelector(`[data-platform-download="${platformConfig.key}"]`);
      const asset = chooseBestAsset(assets, platformConfig.key);
      if (link instanceof HTMLAnchorElement) {
        link.href = asset?.browser_download_url || githubLatestReleaseUrl;
        const detail = link.querySelector('.download-detail');
        if (detail) detail.textContent = formatAssetSize(asset?.size);
      }
    });
  }

  function updateReleaseMetadata(release) {
    const releaseName = release.name || release.tag_name || 'Latest release';
    const publishedAt = release.published_at ? new Date(release.published_at) : null;
    const releaseDate = publishedAt && !Number.isNaN(publishedAt.valueOf())
      ? publishedAt.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })
      : 'See GitHub for release details';

    document.querySelectorAll('[data-release-name]').forEach((element) => {
      element.textContent = releaseName;
    });
    document.querySelectorAll('[data-release-date]').forEach((element) => {
      element.textContent = releaseDate;
    });
  }

  async function hydrateDownloads() {
    const visitorPlatform = detectVisitorPlatform();
    const visitorPlatformConfig = platformDownloads.find((item) => item.key === visitorPlatform) || platformDownloads[0];

    try {
      const response = await fetch(githubLatestReleaseApiUrl, {
        headers: { Accept: 'application/vnd.github+json' },
      });

      if (!response.ok) throw new Error(`GitHub release lookup failed: ${response.status}`);

      const release = await response.json();
      const assets = Array.isArray(release.assets) ? release.assets : [];
      updateReleaseMetadata(release);
      setPrimaryDownload(visitorPlatformConfig, chooseBestAsset(assets, visitorPlatformConfig.key));
      updatePlatformLinks(assets);
    } catch {
      setPrimaryDownload(visitorPlatformConfig, null);
    }
  }

  hydrateDownloads();

  function formatCount(value) {
    return Number.isFinite(value) ? new Intl.NumberFormat().format(value) : '—';
  }

  async function fetchGitHubJson(url) {
    const response = await fetch(url, { headers: { Accept: 'application/vnd.github+json' } });
    if (!response.ok) throw new Error(`GitHub lookup failed: ${response.status}`);
    return response.json();
  }

  function renderRepositoryStats(repo) {
    const values = {
      stars: repo.stargazers_count,
      forks: repo.forks_count,
      issues: repo.open_issues_count,
    };

    Object.entries(values).forEach(([key, value]) => {
      document.querySelectorAll(`[data-repo-stat="${key}"]`).forEach((element) => {
        element.textContent = formatCount(value);
      });
    });

    document.querySelectorAll('[data-github-stars]').forEach((element) => {
      element.textContent = `${formatCount(repo.stargazers_count)} ★`;
    });
  }

  function renderContributors(contributors) {
    const container = document.querySelector('[data-contributors]');
    const label = document.querySelector('[data-contributors-label]');
    if (!container) return;

    container.replaceChildren();
    contributors.slice(0, 6).forEach((contributor) => {
      const link = document.createElement('a');
      link.className = 'av';
      link.href = contributor.html_url || githubRepoUrl;
      link.target = '_blank';
      link.rel = 'noopener';
      link.title = `@${contributor.login}`;
      link.textContent = String(contributor.login || '?').slice(0, 1).toUpperCase();

      const avatar = document.createElement('img');
      avatar.alt = `@${contributor.login}`;
      avatar.loading = 'lazy';
      avatar.addEventListener('load', () => link.replaceChildren(avatar), { once: true });
      avatar.src = contributor.avatar_url;
      container.append(link);
    });

    if (label) label.textContent = contributors.length ? 'Recent public contributors · thank you.' : 'Contributors are listed on GitHub.';
  }

  function renderCommits(commits) {
    const container = document.querySelector('[data-commits]');
    if (!container) return;
    container.replaceChildren();

    commits.slice(0, 5).forEach((commit) => {
      const link = document.createElement('a');
      link.className = 'commit';
      link.href = commit.html_url || `${githubRepoUrl}/commits`;
      link.target = '_blank';
      link.rel = 'noopener';

      const sha = document.createElement('span');
      sha.className = 'sha';
      sha.textContent = String(commit.sha || '').slice(0, 7);

      const message = document.createElement('span');
      message.className = 'msg';
      message.textContent = String(commit.commit?.message || 'Commit').split('\n')[0];

      const author = document.createElement('span');
      author.className = 'who';
      author.textContent = commit.author?.login ? `@${commit.author.login}` : (commit.commit?.author?.name || 'contributor');

      link.append(sha, message, author);
      container.append(link);
    });
  }

  async function hydrateRepository() {
    const [repoResult, contributorsResult, commitsResult] = await Promise.allSettled([
      fetchGitHubJson(githubRepoApiUrl),
      fetchGitHubJson(`${githubRepoApiUrl}/contributors?per_page=6`),
      fetchGitHubJson(`${githubRepoApiUrl}/commits?per_page=5`),
    ]);

    if (repoResult.status === 'fulfilled') renderRepositoryStats(repoResult.value);
    if (contributorsResult.status === 'fulfilled' && Array.isArray(contributorsResult.value)) {
      renderContributors(contributorsResult.value);
    } else {
      const label = document.querySelector('[data-contributors-label]');
      if (label) label.textContent = 'View contributors on GitHub.';
    }
    if (commitsResult.status === 'fulfilled' && Array.isArray(commitsResult.value)) {
      renderCommits(commitsResult.value);
    } else {
      const container = document.querySelector('[data-commits]');
      if (container) {
        const link = document.createElement('a');
        link.className = 'commit';
        link.href = `${githubRepoUrl}/commits`;
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = 'View recent commits on GitHub.';
        container.replaceChildren(link);
      }
    }
  }

  hydrateRepository();


// theme toggle
  (function () {
    const html = document.documentElement;
    const stored = localStorage.getItem('pgc-theme');
    if (stored === 'light') html.classList.add('light');
    const btn = document.getElementById('themeToggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      html.classList.toggle('light');
      localStorage.setItem('pgc-theme', html.classList.contains('light') ? 'light' : 'dark');
    });
  })();

  // before/after compare slider
  (function () {
    const el = document.getElementById('compareSlider');
    if (!el) return;
    let dragging = false;
    function setSplit(clientX) {
      const r = el.getBoundingClientRect();
      const pct = Math.max(0, Math.min(100, ((clientX - r.left) / r.width) * 100));
      el.style.setProperty('--split', pct + '%');
      el.setAttribute('aria-valuenow', String(Math.round(pct)));
    }
    function onDown(e) {
      dragging = true;
      const x = e.touches ? e.touches[0].clientX : e.clientX;
      setSplit(x);
      e.preventDefault();
    }
    function onMove(e) {
      if (!dragging) return;
      const x = e.touches ? e.touches[0].clientX : e.clientX;
      setSplit(x);
    }
    function onUp() { dragging = false; }
    el.addEventListener('mousedown', onDown);
    el.addEventListener('touchstart', onDown, { passive: false });
    el.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      const current = Number(el.getAttribute('aria-valuenow') || 50);
      const next = Math.max(0, Math.min(100, current + (event.key === 'ArrowRight' ? 5 : -5)));
      el.style.setProperty('--split', `${next}%`);
      el.setAttribute('aria-valuenow', String(next));
      event.preventDefault();
    });
    window.addEventListener('mousemove', onMove);
    window.addEventListener('touchmove', onMove, { passive: true });
    window.addEventListener('mouseup', onUp);
    window.addEventListener('touchend', onUp);
    // gentle attention nudge on first view
    let bumped = false;
    const io = new IntersectionObserver((entries) => {
      entries.forEach(en => {
        if (en.isIntersecting && !bumped) {
          bumped = true;
          let p = 50, dir = 1, steps = 0;
          const id = setInterval(() => {
            p += dir * 1.2;
            if (p > 62) dir = -1;
            if (p < 38) dir = 1;
            el.style.setProperty('--split', p + '%');
            steps++;
            if (steps > 60) { clearInterval(id); el.style.setProperty('--split', '50%'); }
          }, 16);
        }
      });
    }, { threshold: 0.4 });
    io.observe(el);
  })();

  // tabs in the demo section
  (function () {
    const tabs = document.querySelectorAll('.product-tabs button');
    const panels = {
      browse: document.getElementById('tab-browse'),
      schema: document.getElementById('tab-schema'),
      query: document.getElementById('tab-query'),
    };
    tabs.forEach(t => t.addEventListener('click', () => {
      tabs.forEach(x => x.classList.remove('active'));
      tabs.forEach(x => x.setAttribute('aria-selected', 'false'));
      t.classList.add('active');
      t.setAttribute('aria-selected', 'true');
      Object.values(panels).forEach(p => p.style.display = 'none');
      panels[t.dataset.tab].style.display = 'block';
    }));
  })();
</script>
